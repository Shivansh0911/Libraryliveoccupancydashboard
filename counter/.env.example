# Copy this file to ".env" and fill in the values. The .env file stays on THIS
# machine and is never shared.

# ── Cloud backend ────────────────────────────────────────────────────────────
BACKEND_URL=https://library-backendd-production.up.railway.app
# Must match DEVICE_API_KEY set on the backend. Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=

# ── Local portal sign-in ─────────────────────────────────────────────────────
PORTAL_EMAIL=it-admin@institute.edu
PORTAL_PASSWORD=change-this-to-a-strong-password
# 127.0.0.1 = reachable only from this machine. Use 0.0.0.0 to allow other
# machines on the institute LAN (behind the institute firewall) to open it.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=8900

# ── Counting ─────────────────────────────────────────────────────────────────
INFERENCE_INTERVAL=3
# true if cameras are ceiling-mounted (top-down view)
CEILING_CAM=false
