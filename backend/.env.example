SECRET_KEY=replace-with-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
DATABASE_URL=sqlite+aiosqlite:///./occupancy.db
CAMERA_OFFLINE_THRESHOLD_SECONDS=30
# Shared secret with the on-prem counter. Generate once, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME value in the counter's .env as DEVICE_API_KEY.
DEVICE_API_KEY=
# Browser origins allowed to call the API (comma-separated). Set to your
# deployed frontend URL. "*" allows any origin — dev only.
ALLOWED_ORIGINS=https://bits-library.netlify.app,http://localhost:5173
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=300
